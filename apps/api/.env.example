# Job X-Ray API — copy to .env and fill in values
PORT=8787
# 127.0.0.1 = this Mac only (default). Use 0.0.0.0 in Docker / cloud.
HOST=127.0.0.1
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Fastest Gemini for this app. Do not switch to gemini-2.5-flash or gemini-3.6-flash.
GEMINI_MODEL=gemini-2.5-flash-lite
LOG_LEVEL=info
EOF